{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "sharpinvotech": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "allowedCommonJsDependencies": [
              "quill"
            ],
            "outputPath": "dist/sharpinvotech/browser",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "src/assets/lib/owlcarousel/assets/owl.carousel.min.css",
              "src/styles.scss"
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/owl.carousel/dist/owl.carousel.min.js"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2000kb",
                  "maximumError": "4000kb"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "sharpinvotech:build:production"
            },
            "development": {
              "browserTarget": "sharpinvotech:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "sharpinvotech:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "inlineFonts": false,
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "src/assets/lib/owlcarousel/assets/owl.carousel.min.css"
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/owl.carousel/dist/owl.carousel.min.js"
            ]
          }
        },
        "server": {
          "builder": "@angular-devkit/build-angular:server",
          "options": {
            "outputPath": "dist/sharpinvotech/server",
            "main": "server.ts",
            "tsConfig": "tsconfig.server.json",
            "inlineStyleLanguage": "scss"
          },
          "configurations": {
            "production": {
              "outputHashing": "media"
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false,
              "vendorChunk": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-ssr": {
          "builder": "@nguniversal/builders:ssr-dev-server",
          "configurations": {
            "development": {
              "browserTarget": "sharpinvotech:build:development",
              "serverTarget": "sharpinvotech:server:development"
            },
            "production": {
              "browserTarget": "sharpinvotech:build:production",
              "serverTarget": "sharpinvotech:server:production"
            }
          },
          "defaultConfiguration": "development"
        },
        "prerender": {
          "builder": "@nguniversal/builders:prerender",
          "options": {
            "routes": [
              "/",
              "/home",
              "/about",
              "/contact",
              "/service",
              "/faq",
              "/team",
              "/testimonial",
              "/feature",
              "/project",
              "/Careers",
              "/privacy",
              "/products",
              "/blogs",
              "/service-pages",
              "/products/web-app-development",
              "/products/mobile-app-development",
              "/products/cloud-development",
              "/products/chatbot-development",
              "/products/digital-marketing-services",
              "/products/ui-development",
              "/products/mssp",
              "/products/data-security-services",
              "/products/cybersecurity-consulting",
              "/products/cybersecurity-grc-services",
              "/products/application-security",
              "/products/network-security",
              "/products/cybersecurity-implementation",
              "/products/cyber-security-awareness",
              "/products/cyber-security-training",
              "/products/cyber-security-manpower-outsourcing",
              "/products/network-infrastructure-services",
              "/products/network-consulting-services",
              "/products/noc",
              "/products/network-infrastructure-maintenance",
              "/products/ai-product-development",
              "/products/ai-ml-services",
              "/products/nlp-services",
              "/products/computer-vision",
              "/products/automation-services",
              "/products/cybersecurity-services",
              "/products/ai-consulting",
              "/products/application-consulting",
              "/products/application-maintenance",
              "/products/manpower-outsourcing",
              "/products/it-server-admin",
              "/products/it-database-administration",
              "/products/pmo-services",
              "/products/oracle-automation",
              "/products/oracle-visual-builder",
              "/products/it-infrastructure",
              "/product/assets-management-system",
              "/product/cleanliness-monitoring",
              "/product/critical-area-monitoring",
              "/product/depot-management-system",
              "/product/drone-solutions",
              "/product/emeregency-module",
              "/product/fleet-management-system",
              "/product/garbage-detection",
              "/product/human-resource-management-system",
              "/product/illegal-parking-monitoring",
              "/product/mdvr-solutions",
              "/product/potholes-detection",
              "/product/ppe-monitoring",
              "/product/remote-sensing",
              "/product/task-management-system",
              "/product/vehicle-collision-detection",
              "/product/vehicle-traffic-detection",
              "/product/sharp-gis"
            ]
          },
          "configurations": {
            "production": {
              "browserTarget": "sharpinvotech:build:production",
              "serverTarget": "sharpinvotech:server:production"
            },
            "development": {
              "browserTarget": "sharpinvotech:build:development",
              "serverTarget": "sharpinvotech:server:development"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  },
  "cli": {
    "analytics": "c9fef07f-aa2a-4708-a319-40ab6ac777ad"
  }
}